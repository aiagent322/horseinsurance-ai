{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "package_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "scenario": {
      "type": "string",
      "minLength": 1
    },
    "corpus_version": {
      "type": "string",
      "const": "quality-corpus-v1"
    },
    "fixture_version": {
      "type": "string",
      "minLength": 1,
      "default": "1"
    },
    "notes": {
      "type": "string",
      "minLength": 1
    },
    "evaluation_scope": {
      "type": "string",
      "enum": [
        "analysis",
        "job",
        "both"
      ]
    },
    "document_order": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "documents": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string",
            "minLength": 1
          },
          "filename": {
            "type": "string",
            "minLength": 1
          },
          "extraction_status": {
            "type": "string",
            "enum": [
              "pending",
              "extracted",
              "partial",
              "ocr_required",
              "failed"
            ]
          },
          "pages": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "page": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "text": {
                  "type": "string"
                },
                "extraction_method": {
                  "type": "string",
                  "enum": [
                    "NATIVE_TEXT",
                    "OCR"
                  ]
                },
                "quality_status": {
                  "type": "string",
                  "enum": [
                    "GOOD",
                    "LOW",
                    "UNREADABLE"
                  ]
                },
                "character_count": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "page",
                "text"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "document_id",
          "filename",
          "pages"
        ],
        "additionalProperties": false
      }
    },
    "expected": {
      "type": "object",
      "properties": {
        "declarations": {
          "type": "object",
          "properties": {
            "present": {
              "type": "boolean"
            },
            "named_insured": {
              "type": [
                "string",
                "null"
              ]
            },
            "policy_number": {
              "type": [
                "string",
                "null"
              ]
            },
            "carrier_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "insured_horse_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "insured_value": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "present",
            "named_insured",
            "policy_number"
          ],
          "additionalProperties": false
        },
        "coverages": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "COVERED",
                  "COVERED WITH LIMITATIONS",
                  "LIMITED",
                  "EXCLUDED",
                  "NOT FOUND",
                  "POSSIBLE CONFLICT",
                  "DOCUMENT MISSING",
                  "NEEDS CLARIFICATION"
                ]
              },
              "limit": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "deductible": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "citation": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "document_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "page": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "document_id",
                      "page"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "acceptable_statuses": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "COVERED",
                    "COVERED WITH LIMITATIONS",
                    "LIMITED",
                    "EXCLUDED",
                    "NOT FOUND",
                    "POSSIBLE CONFLICT",
                    "DOCUMENT MISSING",
                    "NEEDS CLARIFICATION"
                  ]
                }
              },
              "acceptable_needs_review": {
                "type": "boolean"
              }
            },
            "required": [
              "status",
              "citation"
            ],
            "additionalProperties": false
          }
        },
        "limits": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label_contains": {
                "type": "string",
                "minLength": 1
              },
              "amount": {
                "type": "string",
                "minLength": 1
              },
              "citation": {
                "type": "object",
                "properties": {
                  "document_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "page": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "document_id",
                  "page"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "label_contains",
              "amount",
              "citation"
            ],
            "additionalProperties": false
          }
        },
        "exclusions": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "condition_contains": {
                "type": "string",
                "minLength": 1
              },
              "citation": {
                "type": "object",
                "properties": {
                  "document_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "page": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "document_id",
                  "page"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "condition_contains",
              "citation"
            ],
            "additionalProperties": false
          }
        },
        "requirements": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "requirement_contains": {
                "type": "string",
                "minLength": 1
              },
              "citation": {
                "type": "object",
                "properties": {
                  "document_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "page": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "document_id",
                  "page"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "requirement_contains",
              "citation"
            ],
            "additionalProperties": false
          }
        },
        "conflicts": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "description_contains": {
                "type": "string"
              },
              "critical": {
                "type": "boolean",
                "default": true
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": false
          }
        },
        "forms": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "printed_identifier": {
                "type": "string",
                "minLength": 1
              },
              "edition": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "PRESENT",
                  "MISSING",
                  "EDITION MISMATCH"
                ]
              }
            },
            "required": [
              "printed_identifier",
              "status"
            ],
            "additionalProperties": false
          }
        },
        "completeness": {
          "type": "string",
          "enum": [
            "APPEARS COMPLETE",
            "DOCUMENT PACKAGE MAY BE INCOMPLETE"
          ]
        },
        "citations": {
          "type": "object",
          "properties": {
            "required": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "subject": {
                    "type": "string",
                    "minLength": 1
                  },
                  "document_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "page": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "subject",
                  "document_id",
                  "page"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "required"
          ],
          "additionalProperties": false
        },
        "acceptable_needs_review": {
          "type": "boolean"
        },
        "human_review_required": {
          "type": "boolean"
        },
        "critical_errors": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "declarations",
        "coverages",
        "limits",
        "exclusions",
        "requirements",
        "conflicts",
        "forms",
        "completeness",
        "citations",
        "acceptable_needs_review",
        "critical_errors"
      ],
      "additionalProperties": false
    },
    "job": {
      "type": "object",
      "properties": {
        "expected_state": {
          "type": "string",
          "enum": [
            "completed",
            "needs_review",
            "failed",
            "cancelled",
            "processing",
            "missing"
          ]
        },
        "publishable": {
          "type": "boolean"
        },
        "mode": {
          "type": "string",
          "enum": [
            "analyze",
            "cancelled",
            "incomplete",
            "missing_job",
            "inconsistent_binding"
          ]
        },
        "scenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "expected_state": {
                "type": "string",
                "enum": [
                  "completed",
                  "needs_review",
                  "failed",
                  "cancelled",
                  "processing",
                  "missing"
                ]
              },
              "publishable": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "expected_state",
              "publishable"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "expected_state",
        "publishable",
        "mode"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "package_id",
    "title",
    "scenario",
    "corpus_version",
    "notes",
    "evaluation_scope",
    "documents",
    "expected",
    "job"
  ],
  "additionalProperties": false
}

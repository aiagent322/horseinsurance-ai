# Names only. Do not put secrets in this file.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Required in production. Test mode defaults to 30 days if unset.
POLICY_RETENTION_DAYS=

# Production must set this to "true" to allow the educational fixture as a stored analysis.
ENABLE_FIXTURE_ANALYSIS=

# Maintenance-only. Used by the server-side retention purge, never by browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Tests only. Never set to "memory" in production.
POLICY_ANALYZER_STORE=

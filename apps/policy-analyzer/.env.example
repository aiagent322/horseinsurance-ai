# Names only. Do not put secrets in this file.

# ---- Browser-safe public configuration ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---- Shared deploy tier ----
# development | test | staging | production
POLICY_ANALYZER_ENV=
# web | worker | worker-once
POLICY_ANALYZER_PROCESS=
# never "memory" in staging or production
POLICY_ANALYZER_STORE=

# ---- Web-server-only configuration ----
POLICY_RETENTION_DAYS=
POLICY_ANALYZER_UPLOADS_ENABLED=
POLICY_ANALYZER_OPS_TOKEN=
ENABLE_FIXTURE_ANALYSIS=

# ---- Worker-only service-role configuration ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
POLICY_ANALYZER_WORKER_ID=

# ---- Operational limits ----
POLICY_ANALYZER_WORKER_CONCURRENCY=
POLICY_ANALYZER_WORKER_CLAIM_LIMIT=
POLICY_ANALYZER_WORKER_POLL_MS=
POLICY_ANALYZER_WORKER_BACKOFF_MAX_MS=
POLICY_ANALYZER_WORKER_SHUTDOWN_MS=
POLICY_ANALYZER_WORKER_HEARTBEAT_MS=
POLICY_ANALYZER_JOB_LEASE_MS=

# ---- OCR limits ----
POLICY_ANALYZER_OCR_TIMEOUT_MS=

# ---- Logging / monitoring ----
POLICY_ANALYZER_LOG_LEVEL=

# ---- Migration authorization (never commit values) ----
POLICY_ANALYZER_ALLOW_STAGING_MIGRATIONS=
POLICY_ANALYZER_STAGING_PROJECT_REF=
POLICY_ANALYZER_STAGING_DB_HOSTS=
POLICY_ANALYZER_ALLOW_PRODUCTION_MIGRATIONS=
POLICY_ANALYZER_PRODUCTION_PROJECT_REF=
POLICY_ANALYZER_PRODUCTION_DB_HOSTS=

# ---- Protected ops probes (server-only; never NEXT_PUBLIC) ----
POLICY_ANALYZER_WORKER_READY_MAX_AGE_MS=
POLICY_ANALYZER_QUEUE_AGE_THRESHOLD_MS=
